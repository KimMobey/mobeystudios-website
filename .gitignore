# Hugo build output (regenerated on every build)
public/

# Hugo lock file
.hugo_build.lock

# Dev scratch — screenshots, references, temporary files (never committed)
_dev/

# Source files for site images (RAW, GIMP, layered originals). The admin
# upload pipeline archives these alongside the converted .webp; they're
# kept locally for re-encoding but never deployed and never committed.
static/images/**/_src/

# Editions tracking data — private record-keeping for editioned works
# (reproductions, sculptures, original prints) and sales against them.
# Backed up separately by infrastructure/backup-editions.sh; never deployed,
# never committed. See _dev/editions-system-spec.md.
editions/

# OS
.DS_Store

# Python bytecode cache (admin_server.py)
__pycache__/
*.pyc
